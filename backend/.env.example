ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://ditsala:ditsala@localhost:5432/ditsala
REDIS_URL=redis://localhost:6379/0

# Real | sandbox — see docs/DITSALA_MASTER_SPEC.md §3.4. Never anything else.
KYC_PROVIDER=sandbox
OTP_PROVIDER=sandbox
EMAIL_PROVIDER=sandbox

# Set real values only in a real .env, never committed. 32+ random bytes —
# HS256 warns below that length.
JWT_SECRET=change-me-to-a-real-32-byte-secret
ACCESS_TOKEN_TTL_MINUTES=15
NATIONAL_ID_PEPPER=change-me-to-a-real-32-byte-secret

# --- Resend (real EmailProvider) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=DITSALA <no-reply@ditsala.app>

# --- Sandbox EmailProvider: local SMTP catcher (Mailpit — infra/docker-compose.yml) ---
SANDBOX_SMTP_HOST=127.0.0.1
SANDBOX_SMTP_PORT=1025
SANDBOX_FROM_ADDRESS=no-reply@ditsala.local

# --- Twilio Verify (OtpProvider) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TWILIO_TEST_VERIFY_SERVICE_SID=

# --- Smile ID (KycProvider) ---
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_API_BASE_URL=https://api.smileidentity.com/v1
SMILE_ID_SANDBOX_PARTNER_ID=
SMILE_ID_SANDBOX_API_KEY=
SMILE_ID_SANDBOX_API_BASE_URL=https://testapi.smileidentity.com/v1
SMILE_ID_CALLBACK_URL=
