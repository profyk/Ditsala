ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://ditsala:ditsala@localhost:5432/ditsala
REDIS_URL=redis://localhost:6379/0

# Real | sandbox — see docs/DITSALA_MASTER_SPEC.md §3.4. Never anything else.
KYC_PROVIDER=sandbox
OTP_PROVIDER=sandbox
EMAIL_PROVIDER=sandbox

# Set real values only in a real .env, never committed.
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15

# Populated in Phase 2 when these providers are wired in — never real values here.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RESEND_API_KEY=
